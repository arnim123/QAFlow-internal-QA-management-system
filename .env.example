# Local SQL Server (docker compose db service). Production uses an external server.
MSSQL_SA_PASSWORD=QAFlow_Local_SA_Passw0rd
MSSQL_PID=Developer

# Host is the compose service name. Use localhost when connecting from the host machine.
DATABASE_URL=mssql+pyodbc://sa:QAFlow_Local_SA_Passw0rd@db:1433/qaflow?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

WORKER_SLEEP_SECONDS=60
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600

# Sign-in. Leave ADMIN_EMAIL or ADMIN_PASSWORD empty to skip seeding.
# JWT_SECRET should be at least 32 characters.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# Odoo. Technical field names and stage ids stay empty until an admin sets them.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_WRITEBACK_ENABLED=false
ODOO_WRITEBACK_DRY_RUN=true
ODOO_QA_CYCLES_ON_FIRST_PASS=

ODOO_FIELD_QA_STARTED=
ODOO_FIELD_QA_PASSED=
ODOO_FIELD_QA_CYCLES=
ODOO_FIELD_TASK_SUB_STATUS=
ODOO_FIELD_ESTIMATED_HOURS=
ODOO_FIELD_ACTUAL_HOURS=

ODOO_STAGE_ID_BETA_PENDING=
ODOO_STAGE_ID_READY_FOR_LIVE=
ODOO_STAGE_ID_PRODUCTION_PENDING=
ODOO_STAGE_ID_WORK_IN_PROGRESS=
ODOO_STAGE_ID_CANCELLED=

ODOO_STAGE_LABEL_BETA_PENDING=Deployed on Beta and Pending For Testing
ODOO_STAGE_LABEL_READY_FOR_LIVE=Tested on Beta & Ready for Live
ODOO_STAGE_LABEL_PRODUCTION_PENDING=Deployed on Production and Pending for Testing
ODOO_STAGE_LABEL_WORK_IN_PROGRESS=Work In Progress
ODOO_STAGE_LABEL_CANCELLED=Cancelled/Merged Tasks

GROKBOT_BASE_URL=
GROKBOT_AUTH_SCHEME=

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Empty keeps the browser on the same origin. Set this only for a split reverse proxy.
VITE_API_BASE_URL=
# Used by the Vite dev server. Inside compose the API service is named api.
VITE_PROXY_TARGET=http://api:8000
